<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>e7d08fed-7fe8-4d6e-be52-99220aff5c29</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WasteRegulatorCaseManagement.Test" />
    <!-- Castle DynamicProxy (used by NSubstitute) emits proxies into a
         separate dynamic assembly. Without this entry NSubstitute
         cannot substitute internal interfaces. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Cases\CaseModuleConfigs\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.102.8" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.101.8" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.100.23" />
    <PackageReference Include="Elastic.CommonSchema.Serilog" Version="9.0.0" />
    <PackageReference Include="Elastic.Serilog.Enrichers.Web" Version="9.0.0" />
    <PackageReference Include="GovukNotify" Version="8.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.HeaderPropagation" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
    <PackageReference Include="MongoDB.Driver.Authentication.AWS" Version="3.13.0" />
    <PackageReference Include="NUlid" Version="1.7.3" />
    <PackageReference Include="Polly.Core" Version="8.9.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.ClientInfo" Version="2.9.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <!-- Explicit overrides to silence NU19xx vulnerability warnings on
       transitive packages pulled in by GovukNotify / MongoDB.Driver. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpCompress" Version="0.50.8" />
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>

</Project>
